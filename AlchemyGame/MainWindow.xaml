<Window x:Class="AlchemyGame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AlchemyGame"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- INVENTORY -->
        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding OpenedElements}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="64" Height="64" Margin="4"
                                Background="#DDD"
                                MouseDown="Element_MouseDown">
                            <Image Source="{Binding ImagePath}"
                                   Stretch="Uniform"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- FIELD -->
        <ItemsControl x:Name="FieldItemsControl"
                  Grid.Column="1"
                  ItemsSource="{Binding FieldElements}"
                  AllowDrop="True"
                  Drop="Canvas_Drop">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas Background="#EEE"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Image Width="64" Height="64"
                           Source="{Binding ImagePath}"
                           Canvas.Left="{Binding X}"
                           Canvas.Top="{Binding Y}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- LOG -->
        <ListBox ItemsSource="{Binding Log}"
                 Height="120"
                 VerticalAlignment="Bottom"/>
    </Grid>
</Window>
